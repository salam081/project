{% extends 'base/base.html' %}
{% load static %}

{% block title %}Consumable Form Fee Management{% endblock %}

{% block content %}
<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="page-header">
                <h1 class="page-title">Consumable Form Fee Management</h1>
            </div>

            <!-- Display Messages -->
            {% if messages %}
                {% for message in messages %}
                    <div class="alert alert-{{ message.tags }} alert-dismissible fade show" role="alert">
                        {{ message }}
                        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>
                    </div>
                {% endfor %}
            {% endif %}

            <!-- Member Search Section -->
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-search"></i> Search Member
                    </h5>
                </div>
                <div class="card-body">
                    <!-- Search by IPPIS (for members) -->
                    <form method="post" class="mb-3">
                        {% csrf_token %}
                        <div class="form-group">
                            <label for="ippis">Search by IPPIS Number</label>
                            <div class="input-group">
                                <input type="text" id="ippis" name="ippis" class="form-control" 
                                       placeholder="Enter IPPIS Number" required>
                                <div class="input-group-append">
                                    <button type="submit" name="search_member" class="btn btn-primary">
                                        <i class="fas fa-search"></i> Search Member
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- New Guest Payment Form -->
            <div class="card mb-4">
                <div class="card-header bg-info text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-plus"></i> New Guest Payment
                    </h5>
                </div>
                <div class="card-body">
                    <form method="post">
                        {% csrf_token %}
                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="guest_name">Guest Name *</label>
                                    <input type="text" id="guest_name" name="guest_name" 
                                           class="form-control" placeholder="Enter full name" required>
                                </div>
                                
                                <div class="form-group">
                                    <label for="guest_phone">Phone Number *</label>
                                    <input type="tel" id="guest_phone" name="guest_phone" 
                                           class="form-control" placeholder="e.g. 08012345678" required>
                                </div>
                                
                                <div class="form-group">
                                    <label for="guest_ippis">IPPIS (Optional)</label>
                                    <input type="number" id="guest_ippis" name="guest_ippis" 
                                           class="form-control" placeholder="Enter IPPIS if available">
                                </div>
                            </div>
                            
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label for="guest_consumable_type">Select Consumable Type *</label>
                                    <select id="guest_consumable_type" name="consumable_type" 
                                            class="form-control" required>
                                        <option value="">Choose consumable type...</option>
                                        {% for type in consumable_types %}
                                            <option value="{{ type.id }}" data-fee="{{ type.request_fee }}">
                                                {{ type.name }} - ₦{{ type.request_fee|floatformat:2 }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                
                                <div class="form-group">
                                    <label>Payment Amount</label>
                                    <div class="input-group">
                                        <div class="input-group-prepend">
                                            <span class="input-group-text">₦</span>
                                        </div>
                                        <input type="text" id="fee_display" class="form-control" 
                                               placeholder="0.00" readonly>
                                    </div>
                                </div>
                                
                                <button type="submit" name="create_guest_payment" 
                                        class="btn btn-info btn-block mt-4">
                                    <i class="fas fa-money-bill-wave"></i> Process Guest Payment
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <!-- Member Information Display -->
            {% if member_info %}
            <div class="card mb-4 border-success">
                <div class="card-header bg-success text-white">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-user-check"></i> Member Found
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p><strong>Name:</strong> {{ member_info.name }}</p>
                            <p><strong>IPPIS:</strong> {{ member_info.ippis }}</p>
                            <p><strong>Type:</strong> <span class="badge badge-success">Member</span></p>
                        </div>
                        <div class="col-md-6">
                            <form method="post">
                                {% csrf_token %}
                                <input type="hidden" name="member_id" value="{{ member_info.id }}">
                                
                                <div class="form-group">
                                    <label for="member_consumable_type">Select Consumable Type</label>
                                    <select id="member_consumable_type" name="consumable_type" class="form-control" required>
                                        <option value="">Choose consumable type...</option>
                                        {% for type in consumable_types %}
                                            <option value="{{ type.id }}">
                                                {{ type.name }} - ₦{{ type.request_fee|floatformat:2 }}
                                            </option>
                                        {% endfor %}
                                    </select>
                                </div>
                                
                                <button type="submit" name="make_payment" class="btn btn-success btn-block">
                                    <i class="fas fa-money-bill-wave"></i> Record Payment
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
            {% endif %}

            <!-- Payment Summary -->
            <div class="row mb-4">
                <div class="col-md-6">
                    <div class="card bg-gradient-success text-white">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-money-bill-alt fa-2x me-3"></i>
                                <div>
                                    <h5 class="card-title mb-0">Total Fees Collected</h5>
                                    <h2 class="mb-0">₦{{ total_fee|floatformat:2 }}</h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card bg-gradient-primary text-white">
                        <div class="card-body text-center">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-receipt fa-2x me-3"></i>
                                <div>
                                    <h5 class="card-title mb-0">Total Payments</h5>
                                    <h2 class="mb-0">{{ fee_count }}</h2>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Payment History -->
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">
                        <i class="fas fa-history"></i> Payment History
                    </h5>
                </div>
                <div class="card-body">
                    {% if page_obj %}
                    <div class="table-responsive">
                        <table class="table table-striped table-hover">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Date</th>
                                    <th>Payer Name</th>
                                    <th>IPPIS</th>
                                    <th>Type</th>
                                    <th>Consumable</th>
                                    <th>Amount</th>
                                    <th>Status</th>
                                    <th>Processed By</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for fee in page_obj %}
                                <tr>
                                    <td>
                                        <small class="text-muted">
                                            {{ fee.created_at|date:"M d, Y" }}<br>
                                            {{ fee.created_at|time:"g:i A" }}
                                        </small>
                                    </td>
                                    <td>
                                        <strong>{{ fee.payer_name }}</strong>
                                    </td>
                                    <td>
                                        {% if fee.payer_ippis %}
                                            <span class="status-badge text-secondary">{{ fee.payer_ippis }}</span>
                                        {% else %}
                                            <span class="text-muted">N/A</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if fee.member %}
                                            <span class="status-badge badge-success">
                                                <i class="fas fa-user"></i> Member
                                            </span>
                                        {% elif fee.guest_request %}
                                            <span class="status-badge badge-info">
                                                <i class="fas fa-user-friends"></i> Guest
                                            </span>
                                        {% else %}
                                            <span class="status-badge badge-secondary">Unknown</span>
                                        {% endif %}
                                    </td>
                                    <td>{{ fee.consumable_type.name }}</td>
                                    <td>
                                        <strong class="text-success">₦{{ fee.form_fee|floatformat:2 }}</strong>
                                    </td>
                                    <td>
                                        {% if fee.status == 'paid' %}
                                            <span class="status-badge badge-success">
                                                <i class="fas fa-check-circle"></i> Paid
                                            </span>
                                        {% elif fee.status == 'used' %}
                                            <span class="status-badge badge-warning">
                                                <i class="fas fa-hand-holding-usd"></i> Used for Loan
                                            </span>
                                        {% elif fee.status == 'expired' %}
                                            <span class="status-badge badge-danger">
                                                <i class="fas fa-times-circle"></i> Expired/Closed
                                            </span>
                                        {% else %}
                                            <span class="status-badge badge-secondary">{{ fee.status|title }}</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if fee.created_by %}
                                            <small>{{ fee.created_by.get_full_name|default:fee.created_by.username }}</small>
                                        {% else %}
                                            <span class="text-muted">N/A</span>
                                        {% endif %}
                                    </td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>

                    <!-- Pagination -->
                    {% if page_obj.has_other_pages %}
                    <nav aria-label="Payment history pagination" class="mt-4">
                        <ul class="pagination justify-content-center">
                            {% if page_obj.has_previous %}
                                <li class="page-item">
                                    <a class="page-link" href="?page=1" aria-label="First">
                                        <span aria-hidden="true">&laquo;&laquo;</span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="?page={{ page_obj.previous_page_number }}" aria-label="Previous">
                                        <span aria-hidden="true">&laquo;</span>
                                    </a>
                                </li>
                            {% endif %}

                            <li class="page-item active">
                                <span class="page-link">
                                    Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}
                                </span>
                            </li>

                            {% if page_obj.has_next %}
                                <li class="page-item">
                                    <a class="page-link" href="?page={{ page_obj.next_page_number }}" aria-label="Next">
                                        <span aria-hidden="true">&raquo;</span>
                                    </a>
                                </li>
                                <li class="page-item">
                                    <a class="page-link" href="?page={{ page_obj.paginator.num_pages }}" aria-label="Last">
                                        <span aria-hidden="true">&raquo;&raquo;</span>
                                    </a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                    {% endif %}

                    {% else %}
                    <div class="text-center py-5">
                        <i class="fas fa-receipt fa-3x text-muted mb-3"></i>
                        <h5 class="text-muted">No payment records found</h5>
                        <p class="text-muted">Start by searching for a member or adding a new guest payment.</p>
                    </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
// Add some interactivity for better UX
document.addEventListener('DOMContentLoaded', function() {
    // Auto-focus on IPPIS input
    const ippisInput = document.getElementById('ippis');
    if (ippisInput) {
        ippisInput.focus();
    }
    
    // Update fee display when consumable type is selected
    const consumableSelect = document.getElementById('guest_consumable_type');
    const feeDisplay = document.getElementById('fee_display');
    
    if (consumableSelect && feeDisplay) {
        consumableSelect.addEventListener('change', function() {
            const selectedOption = this.options[this.selectedIndex];
            const fee = selectedOption.getAttribute('data-fee');
            if (fee) {
                feeDisplay.value = parseFloat(fee).toFixed(2);
            } else {
                feeDisplay.value = '0.00';
            }
        });
    }
    
    // Form validation for guest payment
    const guestPaymentButtons = document.querySelectorAll('button[name="create_guest_payment"]');
    guestPaymentButtons.forEach(function(button) {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            const name = form.querySelector('#guest_name').value.trim();
            const phone = form.querySelector('#guest_phone').value.trim();
            const consumableType = form.querySelector('#guest_consumable_type').value;
            
            if (!name || !phone || !consumableType) {
                e.preventDefault();
                alert('Please fill in all required fields (Name, Phone, and Consumable Type)');
                return false;
            }
            
            // Phone validation (basic Nigerian format)
            const phoneRegex = /^(\+234|234|0)?[789][01]\d{8}$/;
            if (!phoneRegex.test(phone.replace(/\s+/g, ''))) {
                e.preventDefault();
                alert('Please enter a valid Nigerian phone number');
                return false;
            }
            
            // Confirmation
            const selectedOption = form.querySelector('#guest_consumable_type').options[form.querySelector('#guest_consumable_type').selectedIndex];
            const confirmMsg = `Confirm payment for guest "${name}" - ${selectedOption.text}?`;
            if (!confirm(confirmMsg)) {
                e.preventDefault();
                return false;
            }
        });
    });
    
    // Confirmation for member payment submission
    document.querySelectorAll('button[name="make_payment"]').forEach(function(button) {
        button.addEventListener('click', function(e) {
            const form = this.closest('form');
            const consumableSelect = form.querySelector('select[name="consumable_type"]');
            const selectedOption = consumableSelect.options[consumableSelect.selectedIndex];
            
            if (selectedOption && selectedOption.value) {
                const confirmMsg = `Confirm payment for ${selectedOption.text}?`;
                if (!confirm(confirmMsg)) {
                    e.preventDefault();
                }
            }
        });
    });
});
</script>
{% endblock %}