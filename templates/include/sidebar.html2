        </div>

        <!-- ===== MEMBER / NON-STAFF MEMBER SECTION ===== -->
        {% elif user.is_authenticated and user.group.title == 'members' or user.group.title == 'non staff member' %}

        <!-- Dashboard -->
        <div class="nav-item">
            {% if user.group.title == 'members' %}
            <a href="{% url 'member_dashboard' %}" class="nav-link">
                <i class="bi bi-speedometer2"></i>
                <span class="nav-text">Dashboard</span>
            </a>
            {% elif user.group.title == 'non staff member' %}
            <a href="{% url 'non_staff_dashboard' %}" class="nav-link">
                <i class="bi bi-speedometer2"></i>
                <span class="nav-text">Dashboard</span>
            </a>
            {% endif %}
        </div>

        <!-- My Savings -->
        <div class="nav-item">
            <a href="{% url 'member_savings' %}" class="nav-link">
                <i class="bi bi-wallet-fill"></i>
                <span class="nav-text">My Savings</span>
            </a>
        </div>
        {% comment %} <div class="nav-item">
              <a href="{% url 'my_target_savings_withdrawals' %}" class="nav-link">
                <i class="bi bi-list"></i>
                <span class="nav-text">My Target Savings Withdrawals</span>
            </a>
        </div> {% endcomment %}

        <!-- Loan -->
        <div class="nav-item">
            <a href="{% url 'my_loan_requests' %}" class="nav-link">
                <i class="bi bi-bank2"></i>
                <span class="nav-text">Loan</span>
            </a>
        </div>

        <!-- Consumable -->
        <div class="nav-item">
            <a href="{% url 'my_consumablerequests' %}" class="nav-link">
                <i class="bi bi-cart4"></i>
                <span class="nav-text">Consumable</span>
            </a>
        </div>

        <!-- Project Finance -->
        <div class="nav-item">
            <a href="{% url 'project_finance_application_list' %}" class="nav-link">
                <i class="bi bi-folder"></i>
                <span class="nav-text">Project Finance</span>
            </a>
        </div>

        <!-- Withdrawal Dropdown -->
        <div class="nav-item">
            <button class="nav-link" data-bs-toggle="collapse" data-bs-target="#withdrawalSubmenu" aria-expanded="false" aria-controls="withdrawalSubmenu">
                <i class="bi bi-wallet"></i>
                <span class="nav-text">Withdrawal</span>
                <i class="bi bi-chevron-down dropdown-arrow"></i>
            </button>
            <div class="collapse submenu" id="withdrawalSubmenu">
                <a href="{% url 'my_partial_withdrawal_requests' %}" class="nav-link">
                    <i class="bi bi-wallet-fill"></i>
                    <span class="nav-text">Partial Withdrawal Request</span>
                </a>
                <a href="{% url 'member_withdrawal_request' %}" class="nav-link">
                    <i class="bi bi-list"></i>
                    <span class="nav-text">Fully Withdrawal Request</span>
                </a>
                <a href="{% url 'request_target_savings_withdrawal' %}" class="nav-link">
                    <i class="bi bi-list"></i>
                    <span class="nav-text">Target Savings Withdrawal</span>
                </a>
            </div>
        </div>

        {% endif %}

    </div>
</nav>