{% extends 'base/base.html' %}
{% load humanize %}
{% block content %}
<div class="container col-12">
    <div class="card-header">
        <h3 class="card-title mb-0">Make Request</h3>
    </div>

    <div class="row justify-content-center">
        <div class="col-12 col-lg-11">

            <!-- Tabs: preserve active tab via URL hash after redirect -->
            <ul class="nav nav-tabs mb-3" id="paymentTabs" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="member-tab" data-bs-toggle="tab"
                        data-bs-target="#member" type="button" role="tab">Member Request</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="guest-tab" data-bs-toggle="tab"
                        data-bs-target="#guest" type="button" role="tab">Non-Member Request</button>
                </li>
            </ul>

            <div class="tab-content">
                <!-- Member Request -->
                <div class="tab-pane fade show active" id="member" role="tabpanel">
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body">
                            <form method="POST" enctype="multipart/form-data" class="mb-4" >
                                {% csrf_token %}
                                <div class="input-group">
                                    <input type="text" name="ippis" class="form-control"
                                        placeholder="Enter Member IPPIS" required>
                                    <button type="submit" name="search_member" class="btn btn-primary">
                                        <i class="fas fa-search me-1"></i> Search
                                    </button>
                                </div>
                            </form>

                            {% if member_info %}
                            <div class="alert alert-info py-2">
                                <h5 class="alert-heading fs-6 mb-1">Found Member</h5>
                                <p class="mb-0 small">
                                    <strong>Name:</strong> {{ member_info.name }} |
                                    <strong>IPPIS:</strong> {{ member_info.ippis }}
                                </p>
                            </div>

                            <form method="post" enctype="multipart/form-data" class="p-3 border rounded bg-light">
                                {% csrf_token %}
                                <input type="hidden" name="member_id" value="{{ member_info.id }}">
                                <div class="row g-3">
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Select Item</label>
                                        <select name="item_id" class="form-select form-select-sm" required>
                                            <option value="">Choose...</option>
                                            {% for item in items %}
                                                <option value="{{ item.id }}">
                                                    {{ item.received_item.brand }} {{ item.received_item.model_name }}
                                                    — ₦{{ item.selling_price_per_unit|intcomma }}
                                                    ({{ item.quantity }} left)
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Quantity</label>
                                        <input type="number" class="form-control form-control-sm"
                                            name="quantity" min="1" value="1" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Guarantor IPPIS</label>
                                        <input type="text" name="guarantor_ippis "
                                            class="form-control form-control-sm">
                                    </div>
                                   
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Duration (Months)</label>
                                        <input type="number" name="duration_months"
                                            class="form-control form-control-sm" min="1" value="1" required>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Upload Payslip</label>
                                        <input type="file" name="file_payslip"
                                            class="form-control form-control-sm" accept="image/*">
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label small fw-bold">Passport Photo</label>
                                        <input type="file" name="passport_photo"
                                            class="form-control form-control-sm" accept="image/*">
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" name="create_request"
                                            class="btn btn-success btn-sm">
                                            <i class="fas fa-paper-plane me-1"></i> Submit Member Request
                                        </button>
                                    </div>
                                </div>
                            </form>
                            {% endif %}
                        </div>
                    </div>
                </div>

                <!-- Guest Request -->
                <div class="tab-pane fade" id="guest" role="tabpanel">
                    <div class="card mb-4 border-0 shadow-sm">
                        <div class="card-body">
                            <form method="post" enctype="multipart/form-data">
                                {% csrf_token %}
                                <div class="row g-3">
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Full Name</label>
                                        <input type="text" name="guest_name"
                                            class="form-control form-control-sm" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">IPPIS Number</label>
                                        <input type="text" name="guest_ippis"
                                            class="form-control form-control-sm" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Phone Number</label>
                                        <input type="text" name="guest_phone"
                                            class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Guarantor IPPIS</label>
                                        <input type="text" name="guarantor_ippis"
                                            class="form-control form-control-sm">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Duration (Months)</label>
                                        <input type="number" name="duration_months"
                                            class="form-control form-control-sm" min="1" value="1" required>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Upload Payslip</label>
                                        <input type="file" name="file_payslip"
                                            class="form-control form-control-sm" accept="image/*">
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label small fw-bold">Passport Photo</label>
                                        <input type="file" name="passport_photo"
                                            class="form-control form-control-sm" accept="image/*">
                                    </div>
                                    <div class="col-md-9">
                                        <label class="form-label small fw-bold">Item</label>
                                        <select name="item_id" class="form-select form-select-sm" required>
                                            <option value="">Select item...</option>
                                            {% for item in items %}
                                                <option value="{{ item.id }}">
                                                    {{ item.received_item.brand }} {{ item.received_item.model_name }}
                                                    — ₦{{ item.selling_price_per_unit|intcomma }}
                                                    ({{ item.quantity }} left)
                                                </option>
                                            {% endfor %}
                                        </select>
                                    </div>
                                    <div class="col-md-3">
                                        <label class="form-label small fw-bold">Qty</label>
                                        <input type="number" class="form-control form-control-sm"
                                            name="quantity" min="1" value="1" required>
                                    </div>
                                    <div class="col-12">
                                        <button type="submit" name="make_guest_Request"
                                            class="btn btn-success btn-sm">
                                            <i class="fas fa-save me-1"></i> Submit Guest Request
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Recent Requests -->
            <div class="d-flex justify-content-between align-items-center mt-4 mb-3">
                <h4 class="fs-5 mb-0">Recent Requests</h4>
            </div>
            <!-- FIX: removed broken filter form that used undefined
                 consumable_types / selected_consumable_type_id context vars -->

            <div class="table-responsive">
                <table class="table table-hover align-middle border shadow-sm">
                    <thead class="table-info">
                        <tr>
                            <th>Member</th>
                            <th>IPPIS</th>
                            <th class="text-nowrap text-truncate" style="max-width: 270px;">Requested Items</th>
                            <th class="text-nowrap text-truncate" style="max-width: 270px;">Total Amount</th>
                            <th>Status</th>
                            <th class="text-nowrap text-truncate" style="max-width: 270px;">Amount Paid</th>
                            <th>Balance</th>
                            <th class="text-nowrap text-truncate" style="max-width: 270px;">Approved By</th>
                            {% comment %} <th>Date</th> {% endcomment %}
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for fee in page_obj %}
                        <tr>
                            <!-- NAME -->
                            <td class="text-nowrap">
                                <div class="fw-bold">
                                   {% if fee.member %}
                                        {{ fee.member.member.get_full_name|default:fee.member.member.first_name }}
                                    {% else %}
                                        {{ fee.guest_name }}
                                        <span class="status-badge bg-danger fw-bold px-1"
                                            style="font-size:0.6rem;">GUEST</span>
                                    {% endif %}
                                </div>
                            </td>

                            <!-- IPPIS -->
                            <!-- FIX: wrap in try-style check to avoid RelatedObjectDoesNotExist crash -->
                            <td>
                                {% if fee.member %}
                                    {{ fee.member.ippis|default:"--" }}
                                {% else %}
                                    {{ fee.guest_ippis|default:"--" }}
                                {% endif %}
                            </td>

                            <!-- ITEMS — prefetch covers details__item__received_item -->
                            <td class="small">
                                {% for d in fee.details.all %}
                                    <div>
                                        {{ d.item.received_item.brand }}
                                        {{ d.item.received_item.model_name }}
                                        (x{{ d.quantity }})
                                    </div>
                                {% empty %}
                                    <span class="text-muted">No items</span>
                                {% endfor %}
                            </td>

                            <!-- TOTAL — use precomputed value from annotated queryset -->
                            <td class="fw-bold">₦{{ fee.calculate_total_price|intcomma }}</td>

                            <!-- STATUS -->
                            <td class="text-white">
                                {% if fee.status == "Pending" %}
                                    <span class="status-badge bg-warning text-dark">Pending</span>
                                {% elif fee.status == "Approved" %}
                                    <span class="status-badge bg-success">Approved</span>
                                {% elif fee.status == "Declined" %}
                                    <span class="status-badge bg-danger">Declined</span>
                                {% elif fee.status == "ItemPicked" %}
                                    <span class="status-badge bg-info">Picked</span>
                                {% elif fee.status == "Fully Paid" %}
                                    <span class="status-badge bg-primary">Fully Paid</span>
                                {% else %}
                                    <span class="status-badge bg-secondary">{{ fee.status }}</span>
                                {% endif %}
                            </td>

                            <td class="text-success small">₦{{ fee.total_paid|intcomma }}</td>
                            <!-- FIX: compute balance in template to avoid double query -->
                            <td class="text-danger small">
                                ₦{{ fee.balance|intcomma }}
                            </td>

                            <!-- HANDLED BY -->
                            <td class="text-nowrap text-truncate" style="max-width: 270px;">{{ fee.approved_by.get_full_name|default:"--" }}</td>

                            <!-- DATE -->
                            {% comment %} <td class="text-nowrap text-truncate" style="max-width: 270px;">
                                {{ fee.date_created|date:"d/m/y H:i" }}
                            </td> {% endcomment %}

                            <!-- ACTIONS -->
                            <td>
                               <div class="btn-group">
                                    {% if fee.status == "Pending" %}
                                    <a href="{% url 'make_request_details' fee.id %}"
                                        class="btn btn-outline-warning btn-sm">Details</a>
                                        <a href="{% url 'approve_request' fee.id %}"
                                            class="btn btn-outline-success btn-sm">Approve</a>
                                        <a href="{% url 'decline_request' fee.id %}"
                                            class="btn btn-outline-danger btn-sm">Decline</a>
                                    {% elif fee.status == "Approved" %}
                                        <a href="{% url 'picked_request' fee.id %}"
                                            class="btn btn-outline-primary btn-sm">Pick</a>
                                    {% else %} 
                                        <a href="{% url 'make_request_details' fee.id %}"
                                            class="btn btn-warning btn-sm">Details</a>       
                                    {% endif %}
                                </div>
                            </td>
                        </tr>
                        {% empty %}
                        <tr>
                            <td colspan="10" class="text-center py-5">
                                <p class="text-muted mb-0">No requests found.</p>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            {% if page_obj.has_other_pages %}
            <nav class="mt-3">
                <ul class="pagination pagination-sm justify-content-center">
                    {% if page_obj.has_previous %}
                        <li class="page-item">
                            <a class="page-link" href="?page={{ page_obj.previous_page_number }}">Prev</a>
                        </li>
                    {% endif %}
                    <li class="page-item disabled">
                        <span class="page-link">
                            Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}
                        </span>
                    </li>
                    {% if page_obj.has_next %}
                        <li class="page-item">
                            <a class="page-link" href="?page={{ page_obj.next_page_number }}">Next</a>
                        </li>
                    {% endif %}
                </ul>
            </nav>
            {% endif %}

        </div>
    </div>
</div>

<!-- FIX: preserve active tab across redirects using URL hash -->
<script>
    const hash = window.location.hash;
    if (hash) {
        const tab = document.querySelector(`[data-bs-target="${hash}"]`);
        if (tab) new bootstrap.Tab(tab).show();
    }
    document.querySelectorAll('[data-bs-toggle="tab"]').forEach(tab => {
        tab.addEventListener('shown.bs.tab', e => {
            history.replaceState(null, null, e.target.dataset.bsTarget);
        });
    });
</script>
{% endblock %}