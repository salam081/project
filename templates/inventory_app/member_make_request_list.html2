{% extends "base/base.html" %}
{% load humanize %}

{% block content %}

    <div class="container py-4">
        <div class="row mb-4 align-items-center">
            <div class="col-md-7">
                <h2 class="fw-bold text-dark">Member Requests</h2>
                <p class="text-muted">List of all member requests for inventory items.</p>
            </div>
            <div class="col-md-4">
                 <!-- Middle Section: Search Form -->
            <form method="get" action="" class="d-flex flex-nowrap gap-2 align-items-center">
                <input  type="text" name="search" value="{{ search_query }}" placeholder=" Ippis, First name" 
                    class="form-control form-control-sm" style="min-width: 150px;">
                <button type="submit" class="btn btn-primary btn-sm text-nowrap">
                    <i class="bi bi-search"></i> Search
                </button>
                <a href="{% url 'member_make_request_list' %}" class="btn btn-warning btn-sm text-nowrap text-white">
                Clear Filter
            </a>
            </form>
            </div>
        </div>
       
        <div class="row mt-2">
            <div class="col">
            <!-- Modern Flat Table Wrap -->
                <div class="card border-0 shadow-sm overflow-hidden mb-4">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-info bg-opacity-75 small text-uppercase tracking-wider">
                            <tr>
                                <th class="ps-4 py-3">Member</th>
                                <th class="py-3">IPPIS</th>
                                <th class="py-3" style="max-width: 250px;">Requested Items</th>
                                <th class="py-3">Total Amount</th>
                                <th class="py-3">Status</th>
                                <th class="py-3">Amount Paid</th>
                                <th class="py-3">Balance</th>
                                <th class="py-3">Approved By</th>
                                <th class="pe-4 py-3 text-end">Action</th>
                            </tr>
                            </thead>
                        <tbody class="border-top-0">
            {% for fee in page_obj %}
            <tr>
                <!-- Name Column: Handles Member vs Guest -->
                <td class="ps-4 text-nowrap">
                    <span class="fw-semibold text-dark">
                    {% if fee.member %}
                            {{ fee.member.member.get_full_name|default:fee.member.member.first_name }}
                        {% else %}
                            {{ fee.guest_name }}
                            <span class="status-badge bg-danger-subtle text-danger fw-bold ms-1" style="font-size:0.55rem; letter-spacing: 0.5px;">GUEST</span>
                        {% endif %}
                    </span>
                </td>

                <!-- IPPIS Column: Handles Member vs Guest -->
                <td>
                    <code class="text-secondary small fw-mono">
                        {% if fee.member %}
                            {{ fee.member.ippis|default:"--" }}
                        {% else %}
                            {{ fee.guest_ippis|default:"--" }}
                        {% endif %}
                    </code>
                </td>

                <!-- Items -->
                <td class="small text-secondary">
                    {% for d in fee.details.all %}
                        <div class="text-truncate" style="max-width: 220px;">
                            <i class="fas fa-box-open text-muted me-1 small"></i>{{ d.item.received_item.brand }} {{ d.item.received_item.model_name }} <span class="text-primary fw-bold">(x{{ d.quantity }})</span>
                        </div>
                    {% empty %}
                        <span class="text-muted italic">No items attached</span>
                    {% endfor %}
                </td>

                <!-- Total Amount -->
                <td class="fw-bold text-dark">₦{{ fee.calculate_total_price|intcomma }}</td>

                <!-- Status Badges -->
                <td>
                    {% if fee.status == "Pending" %}
                        <span class="status-badge bg-warning text-dark px-2.5 py-1.5"><i class="fas fa-clock me-1"></i>Pending</span>
                    {% elif fee.status == "Approved" %}
                        <span class="status-badge bg-success-subtle text-success px-2.5 py-1.5"><i class="fas fa-check-circle me-1"></i>Approved</span>
                    {% elif fee.status == "Declined" %}
                        <span class="status-badge bg-danger-subtle text-danger px-2.5 py-1.5"><i class="fas fa-times-circle me-1"></i>Declined</span>
                    {% elif fee.status == "ItemPicked" %}
                        <span class="status-badge bg-info-subtle text-info px-2.5 py-1.5"><i class="fas fa-hand-holding me-1"></i>Picked</span>
                    {% elif fee.status == "Fully Paid" %}
                        <span class="status-badge bg-primary-subtle text-primary px-2.5 py-1.5"><i class="fas fa-handshake me-1"></i>FullyPaid</span>
                    {% else %}
                        <span class="status-badge bg-secondary px-2 py-1">{{ fee.status }}</span>
                    {% endif %}
                </td>

                <!-- Financial Ledger Elements -->
                <td class="text-success small fw-semibold">₦{{ fee.total_paid|intcomma }}</td>
                <td class="text-danger small fw-semibold">₦{{ fee.balance|intcomma }}</td>

                <!-- Approved By -->
                <td class="text-muted small text-nowrap">
                    {{ fee.approved_by.get_full_name|default:"--" }}
                </td>

                <!-- Context Actions -->
                <td class="pe-4 text-end">
                <div class="btn-group shadow-sm rounded">
                        {% if fee.status == "Pending" %}
                            <a href="{% url 'make_request_details' fee.id %}" class="btn btn-light btn-sm text-warning border" title="View Details"><i class="bi bi-eye"></i></a>
                            <a href="{% url 'approve_request' fee.id %}" class="btn btn-light btn-sm text-success border" title="Approve Request"><i class="bi bi-check"></i></a>
                            <a href="{% url 'decline_request' fee.id %}" class="btn btn-light btn-sm text-danger border" title="Decline Request"><i class="bi bi-trash"></i></a>
                        {% elif fee.status == "Approved" %}
                            <a href="{% url 'picked_request' fee.id %}" class="btn btn-primary btn-sm px-2 fw-semibold text-white" title="make item Picked "><i class="bi bi-check2"></i></a>
                        {% else %} 
                            <a href="{% url 'make_request_details' fee.id %}" class="btn btn-primary btn-sm text-white "title="View Details"><i class="bi bi-eye"></i></a>       
                        {% endif %}
                    </div>
                </td>
            </tr>
            {% empty %}
            <tr>
                <td colspan="9" class="text-center py-5 bg-light">
                    <p class="text-muted fw-medium mb-0">No historical workflow logs found.</p>
                </td>
            </tr>
            {% endfor %}
        </tbody>
            </table>
                </div>
                    </div>
                    <!-- Enhanced Scannable Pagination Controls -->
                    {% if page_obj.has_other_pages %}
                    <nav class="mt-4">
                        <ul class="pagination pagination-sm justify-content-center gap-1">
                            {% if page_obj.has_previous %}
                                <li class="page-item">
                                    <a class="page-link rounded-2 border shadow-sm px-3" href="?page={{ page_obj.previous_page_number }}">Previous</a>
                                </li>
                            {% endif %}
                            <li class="page-item disabled">
                                <span class="page-link rounded-2 border-0 text-dark fw-semibold mx-2">
                                    Page {{ page_obj.number }} of {{ page_obj.paginator.num_pages }}
                                </span>
                            </li>
                            {% if page_obj.has_next %}
                                <li class="page-item">
                                    <a class="page-link rounded-2 border shadow-sm px-3" href="?page={{ page_obj.next_page_number }}">Next</a>
                                </li>
                            {% endif %}
                        </ul>
                    </nav>
                    {% endif %}
                </div>
                    
    </div>


{% endblock %}