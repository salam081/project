{% extends 'base/base.html' %}

{% block content %}

<style>
    .form-group {
        margin-bottom: 24px;
    }

    .form-group label {
        display: block;
        font-weight: 600;
        margin-bottom: 8px;
        color: #333;
        font-size: 0.95rem;
    }

    .form-group input,
    .form-group select {
        width: 100%;
        padding: 12px 16px;
        border: 2px solid #e1e5e9;
        border-radius: 8px;
        font-size: 1rem;
        transition: all 0.3s ease;
        background: white;
    }

    .form-group input:focus,
    .form-group select:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 3px rgba(102, 126, 234, 0.1);
    }

    .submit-btn {
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        color: white;
        border: none;
        padding: 13px 22px;
        font-size: 1.1rem;
        font-weight: 600;
        border-radius: 8px;
        cursor: pointer;
        transition: all 0.3s ease;
        display: block;
        margin: 40px auto 0;
        min-width: 200px;
    }

    .submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 20px rgba(102, 126, 234, 0.3);
    }
</style>
<div class="content-card mt-3 p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Request New Consumable</h2>
        <a href="{% url 'my_consumablerequests' %}" class="btn btn-outline-secondary">
            <i class="fas fa-list me-2"></i> My Requests
        </a>
    </div>

    <div class="form-content">
        <form method="post" enctype="multipart/form-data">
            {% csrf_token %}

            <div class="row">
                <div class="form-group col-md-4">
                    <label for="id_consumable_type">Consumable Type</label>
                    <select name="consumable_type" id="id_consumable_type" class="form-control" required>
                        <option value="">Select a consumable type...</option>
                        {% for type in consumable_types %}
                            <option value="{{ type.id }}">{{ type.name }}</option>
                        {% endfor %}
                    </select>
                </div>

                <div class="form-group col-md-4">
                    <label for="id_loan_term_months">Loan Term (in Months)</label>
                    <input type="number" name="loan_term_months" id="id_loan_term_months"
                           placeholder="e.g., 6, 12, 24" min="1" class="form-control" required>
                </div>

                <div class="form-group col-md-4">
                    <label for="id_file_payslpt">Payslip (Image)</label>
                    <input type="file" name="file_payslpt" id="id_file_payslpt" accept="image/*" class="form-control" required>
                </div>
            </div>

            <h3 class="section-title mt-4">Bank Details</h3>
            <div class="row">
               <div class="form-group col-md-4">
                <label for="id_bank_name">Bank Name</label>
                <select name="bank_name" id="id_bank_name" class="form-control" required>
                    <option value="">Select Bank...</option>
                    {% for bank in bank_names %}
                        <option value="{{ bank.id }}">{{ bank.name }}</option>
                    {% endfor %}
                </select>
            </div>
                
                <input type="hidden" name="bank_code_id" id="id_bank_code_id">
                
                  <div class="form-group col-md-4">
                    <label for="bank_code" class="form-label">Bank Code <span class="text-danger">*</span></label>
                    <input type="text" id="bank_code" name="bank_code" class="form-control" readonly required>
                </div>

                <div class="form-group col-md-4">
                    <label for="id_account_number">Account Number</label>
                    <input type="text" name="account_number" id="id_account_number"
                           placeholder="Enter your account number" maxlength="20" class="form-control" required>
                </div>
            </div>

            <h3 class="section-title mt-4">Select Items</h3>
            <div id="item-selection-container">
                {% for item in selling_plans %}
                    <div class="item-row d-flex align-items-center mb-3">
                        <div class="form-check me-3 ">
                            <input class="form-check-input text-success border-success" type="checkbox" id="item_{{ item.id }}" name="selected_items" value="{{ item.id }}">
                        </div>
                        <label class="form-check-label flex-grow-1" for="item_{{ item.id }}">
                            {{ item.purchased_item.item_name }} -
                            <span class="price fw-bold">₦{{ item.selling_price_per_unit|floatformat:0 }}</span>
                            <span class="stock-info badge bg-secondary ms-2">Stock: {{ item.quantity }}</span>
                        </label>
                        <input type="number" name="quantity_{{ item.id }}" placeholder="Quantity"
                               min="1" class="form-control w-25" disabled required>
                    </div>
                {% empty %}
                    <p class="no-items text-muted text-center py-4">No items are currently available.</p>
                {% endfor %}
            </div>

            <button type="submit" class="submit-btn mt-5">Submit Request</button>
        </form>
    </div>
</div>
<script src="/static/js/jquery.js"></script>
<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
document.addEventListener("DOMContentLoaded", function () {
    // ✅ Handle item checkbox/quantity logic
    const itemContainer = document.getElementById("item-selection-container");

    if (itemContainer) {
        itemContainer.addEventListener("change", function (event) {
            if (event.target.type === "checkbox" && event.target.name === "selected_items") {
                const checkbox = event.target;
                const quantityInput = checkbox.closest('.item-row').querySelector('input[type="number"]');

                if (quantityInput) {
                    quantityInput.disabled = !checkbox.checked;
                    quantityInput.required = checkbox.checked;

                    if (checkbox.checked) {
                        quantityInput.focus();
                        quantityInput.value = 1;
                    } else {
                        quantityInput.value = "";
                    }
                }
            }
        });
    }

    // ✅ Fetch bank code dynamically - FIXED VERSION
    $('#id_bank_name').on('change', function () {
        const bankId = $(this).val();
        console.log('Selected bank ID:', bankId); // Debug log
        
        if (bankId) {
            $.ajax({
                url: "{% url 'ajax_load_bank_code' %}",
                method: 'GET',
                data: { 'bank_id': bankId },
                success: function (data) {
                    console.log('AJAX Response:', data); // Debug log
                    $('#bank_code').val(data.code || '');
                    $('#id_bank_code_id').val(data.id || '');
                },
                error: function(xhr, status, error) {
                    console.error('AJAX Error:', error); // Debug log
                    $('#bank_code').val('');
                    $('#id_bank_code_id').val('');
                }
            });
        } else {
            $('#bank_code').val('');
            $('#id_bank_code_id').val('');
        }
    });
});
</script>


{% endblock content %}
