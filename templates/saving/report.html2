{% extends 'base/base.html' %}
{% load humanize %}

{% block content %}
 {% comment %} <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet"> {% endcomment %}
    <style>
      body {
        font-family: 'Inter', sans-serif;
        background-color: #f3f4f6;
      }
    </style>
    <div class="container-fluid">
        <h1 class="text-center text-dark my-4">Financial Report</h1>
        
        <!-- Filter Form -->
        <form id="filter-form" method="GET" class="d-flex flex-column flex-md-row align-items-center justify-content-center gap-4 mb-4 p-4 bg-white rounded-3 shadow">
            <div class="mb-3 mb-md-0">
                <label for="start_date" class="form-label text-dark fw-bold">Start Date:</label>
                <input type="date" id="start_date" name="start_date" class="form-control" value="{{ start_date|date:'Y-m-d'|default:'' }}">
            </div>
            <div class="mb-3 mb-md-0">
                <label for="end_date" class="form-label text-dark fw-bold">End Date:</label>
                <input type="date" id="end_date" name="end_date" class="form-control" value="{{ end_date|date:'Y-m-d'|default:'' }}">
            </div>
            <button type="submit" class="btn btn-primary mt-4 mt-md-0">
                Apply Filter
            </button>
            <a href="{% url 'saving_report' %}" class="btn btn-secondary mt-4 mt-md-0">Reset Filter</a>
        </form>
        
        <!-- Download Button -->
        <div class="text-center mb-4">
            <a href="?format=excel{% if start_date %}&start_date={{ start_date|date:'Y-m-d' }}{% endif %}{% if end_date %}&end_date={{ end_date|date:'Y-m-d' }}{% endif %}" 
               class="btn btn-success">
                Download as Excel
            </a>
        </div>

        <!-- Display Filtered Range -->
        <div class="text-center text-secondary mb-4">
            {% if start_date and end_date %}
                Displaying data from {{ start_date|date:"F j, Y" }} to {{ end_date|date:"F j, Y" }}
            {% else %}
                Displaying All Data
            {% endif %}
        </div>
        
        <!-- Summary Cards -->
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-4 g-4 mb-5">
            <!-- Total Savings Card -->
            <div class="col">
                <div class="card bg-primary text-white h-100 shadow">
                    <div class="card-body">
                        <h5 class="card-title">Total Savings</h5>
                        <p class="card-text ">₦{{ total_savings|floatformat:2 }}</p>
                    </div>
                </div>
            </div>
            <!-- Total Interest Card -->
            <div class="col">
                <div class="card bg-success text-white h-100 shadow">
                    <div class="card-body">
                        <h5 class="card-title">Total Subscription</h5>
                        <p class="card-text ">₦{{ total_interest|floatformat:2 }}</p>
                    </div>
                </div>
            </div>
            <!-- Total Loanable Card -->
            <div class="col">
                <div class="card bg-warning text-white h-100 shadow">
                    <div class="card-body">
                        <h5 class="card-title">Total Loanable</h5>
                        <p class="card-text ">₦{{ total_loanable|floatformat:2 }}</p>
                    </div>
                </div>
            </div>
            <!-- Total Investment Card -->
            <div class="col">
                <div class="card bg-danger text-white h-100 shadow">
                    <div class="card-body">
                        <h5 class="card-title">Total Investment</h5>
                        <p class="card-text ">₦{{ total_investment|floatformat:2 }}</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabbed Interface for Details -->
        <div class="card shadow border p-4">
            <!-- Tab Buttons -->
            <ul class="nav nav-tabs" id="myTab" role="tablist">
                <li class="nav-item" role="presentation">
                    <button class="nav-link active" id="savings-tab-btn" data-bs-toggle="tab" data-bs-target="#savings-tab-pane" type="button" role="tab" aria-controls="savings-tab-pane" aria-selected="true">Savings</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="interest-tab-btn" data-bs-toggle="tab" data-bs-target="#interest-tab-pane" type="button" role="tab" aria-controls="interest-tab-pane" aria-selected="false">Subscription</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="loanable-tab-btn" data-bs-toggle="tab" data-bs-target="#loanable-tab-pane" type="button" role="tab" aria-controls="loanable-tab-pane" aria-selected="false">Loanable</button>
                </li>
                <li class="nav-item" role="presentation">
                    <button class="nav-link" id="investment-tab-btn" data-bs-toggle="tab" data-bs-target="#investment-tab-pane" type="button" role="tab" aria-controls="investment-tab-pane" aria-selected="false">Investment</button>
                </li>
            </ul>
            <!-- Tab Content -->
            <div class="tab-content mt-4" id="myTabContent">
                <!-- Savings Details -->
                <div class="tab-pane fade show active" id="savings-tab-pane" role="tabpanel" aria-labelledby="savings-tab-btn">
                    <h2 class="h5 mb-3">Savings Details</h2>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="savings-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Member</th>
                                    <th scope="col">Month</th>
                                    <th scope="col">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for savings in savings_details %}
                                <tr>
                                    <td>{{ savings.member }}</td>
                                    <td>{{ savings.month|date:"F j, Y" }}</td>
                                    <td>₦{{ savings.month_saving|floatformat:2 }}</td>
                                </tr>
                                {% empty %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No savings data found for this period.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Interest Details -->
                <div class="tab-pane fade" id="interest-tab-pane" role="tabpanel" aria-labelledby="interest-tab-btn">
                    <h2 class="h5 mb-3">Subscription Details</h2>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="interest-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Member</th>
                                    <th scope="col">Month</th>
                                    <th scope="col">Amount Deducted</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for interest in interest_details %}
                                <tr>
                                    <td>{{ interest.member }}</td>
                                    <td>{{ interest.month|date:"F j, Y" }}</td>
                                    <td>₦{{ interest.amount_deducted|floatformat:2 }}</td>
                                </tr>
                                {% empty %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No interest data found for this period.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Loanable Details -->
                <div class="tab-pane fade" id="loanable-tab-pane" role="tabpanel" aria-labelledby="loanable-tab-btn">
                    <h2 class="h5 mb-3">Loanable Details</h2>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="loanable-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Member</th>
                                    <th scope="col">Month</th>
                                    <th scope="col">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for loanable in loanable_details %}
                                <tr>
                                    <td>{{ loanable.member }}</td>
                                    <td>{{ loanable.month|date:"F j, Y" }}</td>
                                    <td>₦{{ loanable.amount|floatformat:2 }}</td>
                                </tr>
                                {% empty %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No loanable data found for this period.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Investment Details -->
                <div class="tab-pane fade" id="investment-tab-pane" role="tabpanel" aria-labelledby="investment-tab-btn">
                    <h2 class="h5 mb-3">Investment Details</h2>
                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="investment-table">
                            <thead class="table-light">
                                <tr>
                                    <th scope="col">Member</th>
                                    <th scope="col">Month</th>
                                    <th scope="col">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                {% for investment in investment_details %}
                                <tr>
                                    <td>{{ investment.member }}</td>
                                    <td>{{ investment.month|date:"F j, Y" }}</td>
                                    <td>₦{{ investment.amount|floatformat:2 }}</td>
                                </tr>
                                {% empty %}
                                <tr>
                                    <td colspan="3" class="text-center text-muted">No investment data found for this period.</td>
                                </tr>
                                {% endfor %}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {% comment %} <!-- Bootstrap JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" xintegrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script> {% endcomment %}

    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const tables = document.querySelectorAll('.table');
            const rowsPerPage = 100;
            
            tables.forEach(table => {
                const tbody = table.querySelector('tbody');
                if (!tbody) return;
                
                const rows = Array.from(tbody.querySelectorAll('tr'));
                const numRows = rows.length;
                if (numRows <= rowsPerPage) return; // No need for pagination if rows are less than or equal to rowsPerPage

                const numPages = Math.ceil(numRows / rowsPerPage);
                let currentPage = 1;

                const paginationContainer = document.createElement('nav');
                paginationContainer.classList.add('d-flex', 'justify-content-center', 'mt-3');
                paginationContainer.setAttribute('aria-label', 'Table Pagination');
                
                const ul = document.createElement('ul');
                ul.classList.add('pagination');
                paginationContainer.appendChild(ul);

                const tableParent = table.parentNode;
                tableParent.appendChild(paginationContainer);

                function displayPage(page) {
                    rows.forEach((row, index) => {
                        const start = (page - 1) * rowsPerPage;
                        const end = page * rowsPerPage;
                        if (index >= start && index < end) {
                            row.style.display = '';
                        } else {
                            row.style.display = 'none';
                        }
                    });

                    // Update active page button
                    ul.querySelectorAll('.page-item').forEach(btn => btn.classList.remove('active'));
                    ul.querySelector(`[data-page="${page}"]`).parentNode.classList.add('active');
                }

                function createPageButtons() {
                    // Previous button
                    const prevLi = document.createElement('li');
                    prevLi.classList.add('page-item');
                    const prevA = document.createElement('a');
                    prevA.classList.add('page-link');
                    prevA.href = '#';
                    prevA.textContent = 'Previous';
                    prevLi.appendChild(prevA);
                    ul.appendChild(prevLi);

                    // Page number buttons
                    for (let i = 1; i <= numPages; i++) {
                        const li = document.createElement('li');
                        li.classList.add('page-item');
                        const a = document.createElement('a');
                        a.classList.add('page-link');
                        a.href = '#';
                        a.textContent = i;
                        a.setAttribute('data-page', i);
                        li.appendChild(a);
                        ul.appendChild(li);

                        a.addEventListener('click', (e) => {
                            e.preventDefault();
                            currentPage = i;
                            displayPage(currentPage);
                        });
                    }

                    // Next button
                    const nextLi = document.createElement('li');
                    nextLi.classList.add('page-item');
                    const nextA = document.createElement('a');
                    nextA.classList.add('page-link');
                    nextA.href = '#';
                    nextA.textContent = 'Next';
                    nextLi.appendChild(nextA);
                    ul.appendChild(nextLi);

                    prevA.addEventListener('click', (e) => {
                        e.preventDefault();
                        if (currentPage > 1) {
                            currentPage--;
                            displayPage(currentPage);
                        }
                    });

                    nextA.addEventListener('click', (e) => {
                        e.preventDefault();
                        if (currentPage < numPages) {
                            currentPage++;
                            displayPage(currentPage);
                        }
                    });
                }
                
                createPageButtons();
                displayPage(1);
            });
        });
    </script>
{% endblock content %}
    
